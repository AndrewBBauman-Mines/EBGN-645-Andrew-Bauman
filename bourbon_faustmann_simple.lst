GAMS 54.3.1  61154be4 Aug 21, 2026          WEX-WEI x86 64bit/MS Windows - 10/12/26 22:51:20 Page 1
Simple Faustmann Model for Bourbon Aging
C o m p i l a t i o n


   2   
   3  * -------------------------------------------------------------------------
   4  * The rickhouse is fixed in size and already full. Each barrel position is
   5  * the "land": when a barrel is sold at age T it is refilled right away, and
   6  * the cycle repeats forever. Choose the aging age T that maximizes the
   7  * value of one barrel position (Faustmann land expectation value, LEV):
   8  *
   9  *    LEV(T) = [ R(T) - C*(1+r)^T ] / [ (1+r)^T - 1 ]
  10  *    R(T)   = p(T) * Q0 * (1-delta)^T
  11  * -------------------------------------------------------------------------
  12   
  13  Set t 'aging age at sale (years)' / 1*15 /;
  14   
  15  Scalar
  16     Q0     'proof gallons at fill (PG per barrel)'           / 66.25 /
  17     delta  'angel share lost per year (fraction per yr)'     / 0.00  /
  18     C      'cost to fill a new barrel ($ per barrel)'        / 585   /
  19     r      'real discount rate (fraction per yr)'            / 0.001  /;
  20   
  21  Parameter p(t) 'value of aged bourbon ($ per PG)'
  22     /  1 10.00,   2 11.50,   3 13.50,   4 16.50,   5 18.50
  23        6 20.25,   7 21.75,   8 23.00,   9 24.00,  10 24.75
  24       11 25.40,  12 26.00,  13 26.50,  14 27.00,  15 27.40 /;
  25   
  26  Parameter
  27     age(t)  'aging age (yr)'
  28     Q(t)    'proof gallons left at age t (PG per barrel)'
  29     Rv(t)   'value of a barrel sold at age t ($ per barrel)'
  30     LEV(t)  'value of one barrel position on a t-year cycle ($ per position)';
  31   
  32  age(t) = ord(t);
  33  Q(t)   = Q0*(1 - delta)**age(t);
  34  Rv(t)  = p(t)*Q(t);
  35  LEV(t) = (Rv(t) - C*(1 + r)**age(t)) / ((1 + r)**age(t) - 1);
  36   
  37  * --- Optimization: pick exactly one aging age -----------------------------
  38  Binary Variable y(t) '1 if barrels are sold at age t';
  39  Variable        z    'value of one barrel position ($ per position)';
  40   
  41  Equation
  42     objective  'value of the chosen cycle'
  43     onlyone    'choose exactly one aging age';
  44   
  45  objective..  z =e= sum(t, LEV(t)*y(t));
  46  onlyone..    sum(t, y(t)) =e= 1;
  47   
  48  Model bourbon / all /;
  49  option optcr = 0;
  50  solve bourbon using mip maximizing z;
  51   
  52  * --- Results ---------------------------------------------------------------
  53  Scalar Tstar 'optimal aging age (yr)';
  54  Tstar = sum(t, age(t)*y.l(t));
  55   
  56  display Q, Rv, LEV, Tstar, z.l;
  57   
  58  * --- Print a results table to a text file --------------------------------
  59  File res / 'results.txt' /;
  60  put res;
  61  put 'Faustmann Bourbon Model - Results' /;
  62  put '---------------------------------------------------------------' /;
  63  put 'Age (yr)':>10, 'Proof gal':>12, '$ per PG':>10, 'Barrel $':>12, 'LEV $':>12 /;
  64  loop(t,
  65     put age(t):10:0, Q(t):12:2, p(t):10:2, Rv(t):12:2, LEV(t):12:2 /;
  66  );
  67  put '---------------------------------------------------------------' /;
  68  put 'Optimal aging age (yr):           ', Tstar:6:0 /;
  69  put 'Value of a barrel position ($):   ', z.l:10:2 /;
  70  putclose res;
  71   
  72  * --- Same table as a CSV for Excel -----------------------------------------
  73  File csv / 'results.csv' /;
  74  csv.pc = 5;
  75  put csv;
  76  put 'Age_yr', 'Proof_gal', 'Price_per_PG', 'Barrel_value', 'LEV' /;
  77  loop(t,
  78     put age(t):0:0, Q(t):0:2, p(t):0:2, Rv(t):0:2, LEV(t):0:2 /;
  79  );
  80  putclose csv;


